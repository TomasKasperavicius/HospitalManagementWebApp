@model List<MedicalHistory>
<div class="mb-3">
    <a asp-action="Appointments" asp-route-doctorID="@ViewBag.DoctorID" asp-controller="Doctor" id="hover" class="btn" style="background-color:#0D8F83; color:white;">
        Back <i class="bi bi-arrow-right"></i>
    </a>
</div>
<div class="d-flex flex-column justify-content-center align-items-center h-100 w-100" id="medical-history-container">
    <table class="table table-hover">
        <thead>
            <tr class="text-center">
                <th scope="col">Condition</th>
                <th scope="col">Date Diagnosed</th>
                <th scope="col">Treatment</th>
                <th scope="col">Notes</th>
            </tr>
        </thead>
        <tbody>
             @for (int i = 0; i < Model.Count; i++)
            {
                <tr class="text-center">
                    <td>@Model[i].Condition</td>
                    <td> @Model[i].DateDiagnosed.ToString("dddd, MMMM dd, yyyy hh:mm tt") </td>
                    <td>@Model[i].Treatment</td>
                    <td>@Model[i].Notes</td>
                </tr>
            }
        </tbody>
    </table>
</div>
