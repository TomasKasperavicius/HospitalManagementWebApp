@model List<DoctorAppointmentView>
@{
}
<div class="mb-3">
    <a asp-action="Index" asp-controller="Home" id="hover" class="btn" style="background-color:#0D8F83; color:white;">
        Back <i class="bi bi-arrow-right"></i>
    </a>
</div>
<form method="post" id="dateForm" asp-action="Appointments" asp-controller="Doctor" asp-route-doctorID="@ViewBag.DoctorID">
    <div class="d-flex align-items-center">
        <label for="Date" class="pe-2">Select date</label>
        <input type="date" onchange="this.form.submit()" class="form-control rounded-pill border-0 w-25" id="Date" name="date" value="@ViewBag.Date.ToString("yyyy-MM-dd")" style="background-color: #EEEEEE;">
    </div>
</form>
<div class="d-flex flex-column justify-content-center align-items-center h-100 w-100" id="doctor-appointments-container">
    <table class="table table-hover">
        <thead>
            <tr class="text-center">
                <th scope="col">Patient Name</th>
                <th scope="col">Time</th>
                <th scope="col">Status</th>
                <th scope="col">View Medical History</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                if (Model[i].appointment.Date <= DateTime.Now)
                {
                    continue;
                }

                <tr class="text-center @(Model[i].appointment.Status == Status.Free ? "table-success" : "table-danger")">
                    <td>@Model[i].patientFullName</td> 
                    <td>@Model[i].appointment.Date.ToString("dddd, MMMM dd, yyyy hh:mm tt")</td>
                    <td>@Model[i].appointment.Status</td>

                    <td>
                        <a href="/Patient/MedicalHistory?patientId=@Model[i].appointment.UserID" title="View Medical History">
                            <i class="bi bi-file-medical" style="cursor: pointer; color: blue; font-size: 1.5rem;"></i>
                        </a>
                    </td>

                    <td>
                        @if (Model[i].appointment.Status == Status.Free)
                        {
                            <i class="bi bi-check" style="cursor: pointer; color: green; font-size: 1.5rem;"
                               title="Select Appointment"
                               data-bs-toggle="modal"
                               data-userID="@ViewBag.UserID"
                               data-doctorID="@ViewBag.DoctorID"
                               data-Date="@Model[i].appointment.Date"
                               data-bs-target="#selectAppointmentModal">
                            </i>
                        }
                        else
                        {
                            <i class="bi bi-x" style="color: red; font-size: 1.5rem;" title="Unavailable"></i>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    #hover:hover {
        opacity: 0.8;
    }
</style>
